Q16. Determine the parity (even/odd number of set bits) of a 32‑bit integer
    without counting all bits (XOR folding).
    #include <stdio.h>
    int main() {
        unsigned int n;
        scanf("%u", &n);
        n ^= n >> 16;
        n ^= n >> 8;
        n ^= n >> 4;
        n ^= n >> 2;
        n ^= n >> 1;
        if (n & 1)
            printf("Odd parity\n");
        else
            printf("Even parity\n");
        return 0;
    }

Q17. Compute the next higher number with the same number of set bits.
    #include <stdio.h>
    unsigned int nextHigher(unsigned int n) {
        unsigned int c = n & -n;
        unsigned int r = n + c;
        return r | (((n ^ r) >> 2) / c);
    }
    int main() {
        unsigned int n;
        scanf("%u", &n);
        printf("%u\n", nextHigher(n));
        return 0;
    }

