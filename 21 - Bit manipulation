Q13. Given an array where every element occurs three times except one, find that
    single element. (Use bitwise counting modulo 3)
    #include <stdio.h>
    int main() {
        int n;
        scanf("%d", &n);
        int arr[n];
        for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
        int ones = 0, twos = 0;
        for (int i = 0; i < n; i++) {
            ones = (ones ^ arr[i]) & ~twos;
            twos = (twos ^ arr[i]) & ~ones;
        }
        printf("%d\n", ones);
        return 0;
    }

Q14. Generate all subsets of a set of N elements using bitmask iteration.
    #include <stdio.h>
    int main() {
        char set[] = {'A', 'B', 'C'};
        int n = sizeof(set)/sizeof(set[0]);
        int total = 1 << n;
        for (int mask = 0; mask < total; mask++) {
            printf("{ ");
            for (int j = 0; j < n; j++) {
                if (mask & (1 << j))
                    printf("%c ", set[j]);
            }
            printf("}\n");
        }
        return 0;
    }

Q15. Count total number of set bits from 1 to N.
    (Use DP or pattern; here’s a simple O(log N) method)
    #include <stdio.h>
    int countSetBits(int n) {
        int count = 0;
        for (int i = 1; i <= n; i <<= 1) {
            int complete_pairs = (n + 1) / (i << 1);
            count += complete_pairs * i;
            int remainder = (n + 1) % (i << 1);
            count += (remainder > i) ? (remainder - i) : 0;
        }
        return count;
    }
    int main() {
        int n;
        scanf("%d", &n);
        printf("%d\n", countSetBits(n));
        return 0;
    }

