Q21. Find two non‑repeating elements in an array where all others appear twice.
    (Use XOR, then separate by a set bit)
    #include <stdio.h>
    void findTwoUnique(int arr[], int n) {
        int xor_all = 0;
        for (int i = 0; i < n; i++) xor_all ^= arr[i];
        int set_bit = xor_all & -xor_all; // rightmost set bit
        int a = 0, b = 0;
        for (int i = 0; i < n; i++) {
            if (arr[i] & set_bit)
                a ^= arr[i];
            else
                b ^= arr[i];
        }
        printf("%d %d\n", a, b);
    }
    int main() {
        int n;
        scanf("%d", &n);
        int arr[n];
        for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
        findTwoUnique(arr, n);
        return 0;
    }

Q22. Count total set bits in all numbers from 1 to N using memoized recursion.
    (Alternative to Q15, another approach)
    #include <stdio.h>
    int countSetBits(int n) {
        if (n <= 0) return 0;
        int m = 0;
        while ((1 << (m + 1)) <= n) m++; // highest power of 2 ≤ n
        int pow2 = 1 << m;
        return (pow2 * m / 2) + (n - pow2 + 1) + countSetBits(n - pow2);
    }
    int main() {
        int n;
        scanf("%d", &n);
        printf("%d\n", countSetBits(n));
        return 0;
    }

