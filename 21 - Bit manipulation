Q25. Generate Gray code for n bits.
    (1 << n codes, each successive code differs by one bit)
    #include <stdio.h>
    int main() {
        int n;
        scanf("%d", &n);
        int total = 1 << n;
        for (int i = 0; i < total; i++) {
            int gray = i ^ (i >> 1);
            // print binary representation
            for (int j = n - 1; j >= 0; j--)
                printf("%d", (gray >> j) & 1);
            printf("\n");
        }
        return 0;
    }

Q26. Check if a number is a power of 8.
    (Same as power of two + set bit position is multiple of 3)
    #include <stdio.h>
    int main() {
        int n;
        scanf("%d", &n);
        if (n > 0 && !(n & (n - 1))) {
            int pos = 0;
            while (n > 1) {
                n >>= 1;
                pos++;
            }
            if (pos % 3 == 0)
                printf("Yes\n");
            else
                printf("No\n");
        } else
            printf("No\n");
        return 0;
    }

Q27. Find the majority element (appearing > n/2) using bit counting.
    #include <stdio.h>
    int main() {
        int n;
        scanf("%d", &n);
        int arr[n];
        for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
        int majority = 0;
        for (int i = 0; i < 32; i++) {
            int count = 0;
            for (int j = 0; j < n; j++) {
                if (arr[j] & (1 << i)) count++;
            }
            if (count > n / 2)
                majority |= (1 << i);
        }
        printf("%d\n", majority);
        return 0;
    }

