Q19. Calculate the Hamming distance between two integers (number of differing bits).
    Already done in Q8 (count of set bits in XOR). So:
    #include <stdio.h>
    int main() {
        int a, b;
        scanf("%d %d", &a, &b);
        int diff = a ^ b, dist = 0;
        while (diff) {
            dist++;
            diff &= diff - 1;
        }
        printf("%d\n", dist);
        return 0;
    }

Q20. Find the missing number in an array of size N containing numbers 0..N
    (one missing). XOR all indices and values.
    #include <stdio.h>
    int main() {
        int n;
        scanf("%d", &n); // n = highest number, size = n
        int missing = 0;
        for (int i = 0; i < n; i++) {
            int x;
            scanf("%d", &x);
            missing ^= i ^ x;
        }
        missing ^= n; // because array size is n, indexes 0..n-1, n is missing
        printf("%d\n", missing);
        return 0;
    }

