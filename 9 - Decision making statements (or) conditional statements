/* Q3: Hi / Hello / HiHello using if–else ladder */
#include <stdio.h>
int main() {
    int num;
    scanf("%d", &num);
    if (num % 3 == 0 && num % 5 == 0)
        printf("HiHello");
    else if (num % 3 == 0)
        printf("Hi");
    else if (num % 5 == 0)
        printf("Hello");
    return 0;
}


