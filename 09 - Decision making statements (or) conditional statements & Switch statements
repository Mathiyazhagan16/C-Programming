    {
        statements;
    }

2) if else statement (or) two state if 

    if(condition) 
    {
        statements;//true
    }
    else
    {
        statements;//false
    }

3) else if ladder (or) cascaded if (or) multi state if

    if(condition)
    {
        statements;
    }
    else if(condition)
    {
        statement;
    }
    else if(condition)
    {
        statement;
    }
    else if(condition)
    {
        statement;
    }
    else 
    {
        statements;(optional)
    }

4) Nested if

    if(condition)
    {
        statements;
        if(condition)
        {
            statements;
        }
    }
    else 
