[Kaprekar Number]
    Definition: 297² = 88209
    Split 88209 into two parts and sum: 8+8209=8217, 88+209=297 (equals original) → Kaprekar

    Steps:
        1. Compute sq = n * n.
        2. Count digits of sq → d.
        3. For pos_v = 10; pos_v <= 10^d; pos_v *= 10:
               right_part = sq % pos_v;
               left_part  = sq / pos_v;
               if (right_part > 0 && left_part + right_part == n) → Kaprekar.
        4. If no split works → not Kaprekar.

    Solution:
        #include <stdio.h>
        int main() {
            int n, sq, temp, d, pos;
            scanf("%d", &n);
            sq = n * n;
            temp = sq;
            d = 0;
            while (temp) { d++; temp /= 10; }
            int isKap = 0;
            for (pos = 10; pos <= pow(10,d); pos *= 10) {
                int right = sq % pos;
                int left = sq / pos;
                if (right > 0 && left + right == n) {
                    isKap = 1;
                    break;
                }
            }
            if (isKap) printf("Kaprekar number\n");
            else printf("Not Kaprekar number\n");
            return 0;
        }

