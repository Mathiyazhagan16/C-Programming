[Catalan Number]
    Sequence: 1,1,2,5,14,42,... Formula: Cₙ = (2n)! / (n!(n+1)!).
    To check if x is a Catalan number: generate Catalan numbers until you reach or exceed x.

    Solution:
        #include <stdio.h>
        unsigned long long catalan(int n) {
            if (n <= 1) return 1;
            unsigned long long res = 0;
            for (int i = 0; i < n; i++)
                res += catalan(i) * catalan(n-i-1);
            return res;
        }
        int main() {
            unsigned long long x;
            int i = 0;
            scanf("%llu", &x);
            while (1) {
                unsigned long long c = catalan(i);
                if (c == x) { printf("Catalan number\n"); return 0; }
                if (c > x)  { printf("Not Catalan number\n"); return 0; }
                i++;
            }
        }
    (Note: for larger numbers use dynamic programming to generate catalans efficiently.)

