[Perfect Number]
    Sum of proper divisors (factors excluding the number itself) == number.
    Example: 6 = 1+2+3 ; 28 = 1+2+4+7+14

    Steps:
        1. Sum = 1.
        2. Loop i from 2 to sqrt(n):
               if n % i == 0:
                   sum += i;
                   if (i != n/i) sum += n/i;
        3. If sum == n (and n != 1) → Perfect.

    Solution:
        #include <stdio.h>
        #include <math.h>
        int main() {
            int n, sum = 1;
            scanf("%d", &n);
            if (n == 1) { printf("Not Perfect\n"); return 0; }
            for (int i = 2; i <= sqrt(n); i++) {
                if (n % i == 0) {
                    sum += i;
                    if (i != n/i) sum += n/i;
                }
            }
            if (sum == n) printf("Perfect number\n");
            else printf("Not Perfect number\n");
            return 0;
        }

