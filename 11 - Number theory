[Armstrong Number]
    Example: 153
    Digits: 1, 5, 3  (count = 3)
    1³ + 5³ + 3³ = 1 + 125 + 27 = 153 == original → Armstrong

    Steps:
        1. Count digits (c).
        2. Extract digits right‑side.
        3. For each digit, compute digit^c and sum.
        4. If sum == original → Armstrong.

    Solution:
        #include <stdio.h>
        #include <math.h>
        int main() {
            int n, temp, digit, sum = 0, count = 0;
            scanf("%d", &n);
            temp = n;
            while (temp) {
                count++;
                temp /= 10;
            }
            temp = n;
            while (temp) {
                digit = temp % 10;
                sum += pow(digit, count);   // or use a custom power function
                temp /= 10;
            }
            if (sum == n)
                printf("Armstrong number\n");
            else
                printf("Not Armstrong number\n");
            return 0;
        }

───────────────────────────────────────────────────────────────────────────

[Strong Number]
    Example: 145
    1! + 4! + 5! = 1 + 24 + 120 = 145 == original → Strong

    Steps:
        1. Extract digits (right‑side).
        2. Compute factorial of each digit.
        3. Sum the factorials.
        4. If sum == original → Strong number.

    Solution:
        #include <stdio.h>
        int factorial(int d) {
            int f = 1;
            for (int i = 2; i <= d; i++) f *= i;
            return f;
        }
        int main() {
            int n, temp, digit, sum = 0;
            scanf("%d", &n);
            temp = n;
            while (temp) {
                digit = temp % 10;
                sum += factorial(digit);
                temp /= 10;
            }
            if (sum == n)
                printf("Strong number\n");
            else
                printf("Not Strong number\n");
            return 0;
        }

