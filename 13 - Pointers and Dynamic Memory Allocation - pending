4. realloc – Growing an Array
   Problem : Allocate memory for 3 integers, fill them. Then resize to hold 6 integers, keeping the original values. Add 3 more values and print.
   Solution:
        int *arr = (int*)malloc(3 * sizeof(int));
        arr[0] = 1; arr[1] = 2; arr[2] = 3;
        arr = (int*)realloc(arr, 6 * sizeof(int));
        if (arr == NULL) return 1;
        arr[3] = 4; arr[4] = 5; arr[5] = 6;
        for (int i = 0; i < 6; i++) printf("%d ", arr[i]);
        free(arr);

5. String Duplication (Custom strdup)
   Problem : Read a string, dynamically allocate enough memory for a copy, copy it, and print the duplicate.
   Solution:
        char original[100];
        scanf("%s", original);
        int len = strlen(original);
        char *copy = (char*)malloc(len + 1);
        if (copy == NULL) return 1;
        strcpy(copy, original);
        printf("Copy : %s\n", copy);
        free(copy);

6. Sum of Dynamic Array Elements
   Problem : Allocate memory for an array of floats of size N, read values, compute sum, print and free.
   Solution:
        int n;
        scanf("%d", &n);
        float *arr = (float*)malloc(n * sizeof(float));
        if (arr == NULL) return 1;
        float sum = 0;
        for (int i = 0; i < n; i++) {
            scanf("%f", &arr[i]);
            sum += arr[i];
        }
        printf("Sum = %.2f\n", sum);
        free(arr);

7. Memory Leak Prevention
   Problem : Write a program that allocates memory inside a loop. Show the correct way to free memory each iteration to prevent leaks.
   Solution:
        for (int i = 0; i < 3; i++) {
            int *temp = (int*)malloc(10 * sizeof(int));
            if (temp == NULL) return 1;
            // use temp ...
            temp[0] = i;
            free(temp);   // free inside loop
        }
        // No leak because each allocation is freed before the next iteration.

8. Dangling Pointer Prevention
   Problem : Demonstrate how a dangling pointer is created and how to avoid it by setting pointer to NULL after free.
   Solution:
        int *p = (int*)malloc(sizeof(int));
        *p = 42;
        free(p);
        p = NULL;          // safe, no dangling
        // if (p != NULL) printf("%d", *p);  // won't execute, no crash.

9. Dynamic 2D Array (Array of Pointers)
   Problem : Allocate a 2D integer matrix of R rows and C columns, fill with row*col product, print, and free.
   Solution:
        int R = 3, C = 4;
        int **mat = (int**)malloc(R * sizeof(int*));
        if (mat == NULL) return 1;
        for (int i = 0; i < R; i++) {
            mat[i] = (int*)malloc(C * sizeof(int));
            if (mat[i] == NULL) return 1;
            for (int j = 0; j < C; j++) {
                mat[i][j] = i * j;
            }
        }
        for (int i = 0; i < R; i++) {
            for (int j = 0; j < C; j++) printf("%2d ", mat[i][j]);
            printf("\n");
        }
        for (int i = 0; i < R; i++) free(mat[i]);
        free(mat);

10. realloc to Shrink
    Problem : Allocate 10 integers with values 0..9, then shrink to 5 using realloc. Print the first 5 elements (still valid).
    Solution:
        int *arr = (int*)malloc(10 * sizeof(int));
        for (int i = 0; i < 10; i++) arr[i] = i;
        arr = (int*)realloc(arr, 5 * sizeof(int));
        if (arr == NULL) return 1;
        for (int i = 0; i < 5; i++) printf("%d ", arr[i]);  // 0 1 2 3 4
        free(arr);

11. NULL Check and Double Free Avoidance
    Problem : Write a safe free wrapper that checks for NULL and sets the pointer to NULL after freeing.
    Solution:
        void safe_free(void **ptr) {
            if (ptr != NULL && *ptr != NULL) {
                free(*ptr);
                *ptr = NULL;
            }
        }
        // Usage: safe_free((void**)&p);

12. Dynamic Array of Structures
    Problem : Define a Student structure with name and roll. Allocate memory for N students, read details, print, and free.
    Solution:
        typedef struct {
            char name[50];
            int roll;
        } Student;
        int n;
        scanf("%d", &n);
        Student *s = (Student*)malloc(n * sizeof(Student));
        if (s == NULL) return 1;
        for (int i = 0; i < n; i++) {
            scanf("%s %d", s[i].name, &s[i].roll);
        }
        for (int i = 0; i < n; i++) {
            printf("%s %d\n", s[i].name, s[i].roll);
        }
        free(s);

13. Detect and Avoid Memory Leak (Valgrind Hint)
    Problem : Write a small program that purposely forgets to free memory, then correct it.
    Solution (incorrect):
        int *p = (int*)malloc(10*sizeof(int));
        p[0] = 5;
        // missing free(p);  -> memory leak
    Solution (correct):
        int *p = (int*)malloc(10*sizeof(int));
        p[0] = 5;
        free(p);
        p = NULL;




