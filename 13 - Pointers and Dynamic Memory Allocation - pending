5. Sum of Array Elements with a Pointer
   Problem : Calculate the sum of an array’s elements by iterating with a pointer.
   Solution:
        int data[] = {5, 10, 15, 20};
        int sum = 0;
        int *p = data;
        for(int i = 0; i < 4; i++) {
            sum += *(p + i);
        }
        printf("Sum = %d\n", sum);

6. Swap Two Numbers Using Pointers (Function)
   Problem : Write a function that swaps two integers. Call it from main and verify.
   Solution:
        void swap(int *a, int *b) {
            int temp = *a;
            *a = *b;
            *b = temp;
        }
        int main() {
            int x = 10, y = 20;
            swap(&x, &y);
            printf("x = %d, y = %d\n", x, y);
            return 0;
        }

7. Array Modification via Pointer in a Function
   Problem : Write a function that doubles every element of an array. Pass the array and its size.
   Solution:
        void doubleElements(int *arr, int n) {
            for(int i = 0; i < n; i++) {
                *(arr + i) = *(arr + i) * 2;
            }
        }
        int main() {
            int vals[] = {1, 2, 3, 4, 5};
            doubleElements(vals, 5);
            for(int i = 0; i < 5; i++) printf("%d ", vals[i]);
            return 0;
        }

8. Dynamic Memory – Create an Array of User‑Defined Size
   Problem : Read the size N from the user, dynamically allocate memory for N integers, fill with first N squares, and print.
   Solution:
        int n;
        scanf("%d", &n);
        int *arr = (int*)malloc(n * sizeof(int));
        if(arr == NULL) {
            printf("Memory allocation failed\n");
            return 1;
        }
        for(int i = 0; i < n; i++) {
            *(arr + i) = (i+1) * (i+1);   // square
        }
        for(int i = 0; i < n; i++) {
            printf("%d ", *(arr + i));
        }
        free(arr);

9. String Length Using a Pointer
   Problem : Write a function that returns the length of a string by using a pointer to traverse it.
   Solution:
        int myStrlen(char *str) {
            int count = 0;
            while(*str != '\0') {
                count++;
                str++;
            }
            return count;
        }
        // Usage: printf("%d\n", myStrlen("Hello"));

10. Reverse a String in‑place Using Pointers
    Problem : Reverse a given character array without using another array. Use two pointers (start and end).
    Solution:
        void reverse(char *str) {
            int len = strlen(str);
            char *start = str;
            char *end = str + len - 1;
            while(start < end) {
                char temp = *start;
                *start = *end;
                *end = temp;
                start++;
                end--;
            }
        }
        // char s[] = "abcd"; reverse(s); -> "dcba"

