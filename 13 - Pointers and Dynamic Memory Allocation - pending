        int n = sizeof(fruits)/sizeof(fruits[0]);
        for(int i = 0; i < n; i++) {
            printf("%s\n", *(fruits + i));   // fruits[i]
            // or traverse each character
        }

12. Function Pointer – Callback Example
    Problem : Write a function `operate(int a, int b, int (*func)(int, int))` that applies a given operation.
              Provide `add` and `multiply` as callbacks.
    Solution:
        int add(int a, int b)      { return a + b; }
        int multiply(int a, int b) { return a * b; }

        int operate(int a, int b, int (*op)(int, int)) {
            return op(a, b);
        }
        int main() {
            printf("Add : %d\n", operate(10, 20, add));
            printf("Mul : %d\n", operate(10, 20, multiply));
            return 0;
        }

