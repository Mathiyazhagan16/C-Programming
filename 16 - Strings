    Sample Questions

        Sample Questions – Strings

    1. Basic Input and Output – Reading and Printing a String
       Problem : Read a single word (no spaces) from the user and print it.
       Solution:
            #include <stdio.h>
            int main() {
                char str[100];
                scanf("%s", str);
                printf("%s\n", str);
                return 0;
            }

    2. Reading a Whole Line Including Spaces (Scanset)
       Problem : Read an entire line of text (including spaces) until Enter is pressed.
       Solution:
            #include <stdio.h>
            int main() {
                char str[500];
                scanf("%[^\n]", str);
                printf("You entered: %s\n", str);
                return 0;
            }

    3. String Length – Using a Loop
       Problem : Find the length of a string without using the built‑in strlen() function.
       Solution:
            #include <stdio.h>
            int main() {
                char str[] = "Hello World";
                int len = 0;
                while (str[len] != '\0') {
                    len++;
                }
                printf("Length = %d\n", len);
                return 0;
            }

    4. String Length – Using %n
       Problem : Read a string and find its length using the %n format specifier.
       Solution:
            #include <stdio.h>
            int main() {
                char str[100];
                int count = 0;
                scanf("%s%n", str, &count);
                printf("Length of \"%s\" = %d\n", str, count);
                return 0;
            }

    5. Full Reverse of a String
       Problem : Reverse the entire string "One Two Three Four" to "ruoF eerhT owT enO".
       Solution:
            #include <stdio.h>
            #include <string.h>
            int main() {
                char str[] = "One Two Three Four";
                int len = strlen(str);
                for (int i = 0, j = len - 1; i < j; i++, j--) {
                    char temp = str[i];
                    str[i] = str[j];
                    str[j] = temp;
                }
                printf("%s\n", str);
                return 0;
            }

    6. Word‑by‑Word Reverse
       Problem : Reverse the order of words in the string "One Two Three Four"
                to get "Four Three Two One".
       Solution:
            #include <stdio.h>
            #include <string.h>
            void reverse_word(char *start, char *end) {
                while (start < end) {
                    char t = *start;
                    *start++ = *end;
                    *end-- = t;
                }
            }
            int main() {
                char str[] = "One Two Three Four";
                int len = strlen(str);
                // Reverse the whole string first
                reverse_word(str, str + len - 1);
                // Then reverse each word
                char *start = str, *end = str;
                while (*end) {
                    end++;
                    if (*end == ' ' || *end == '\0') {
                        reverse_word(start, end - 1);
                        if (*end) end++;     // skip space
                        start = end;
                    }
                }
                printf("%s\n", str);
                return 0;
            }

    7. Special Reverse (Skip Special Characters)
       Problem : Given a string "@&^H&^E&^@L@L@@$%#O(#)", reverse only the alphabetic
                characters. Special characters remain in place.
                Output: "@&^O&^L&^@L@E@@$%#H(#)"
       Solution:
            #include <stdio.h>
            #include <ctype.h>
            #include <string.h>
            int main() {
                char str[] = "@&^H&^E&^@L@L@@$%#O(#)";
                int i = 0, j = strlen(str) - 1;
                while (i < j) {
                    if (!isalpha(str[i])) i++;
                    else if (!isalpha(str[j])) j--;
                    else {
                        char temp = str[i];
                        str[i] = str[j];
                        str[j] = temp;
                        i++; j--;
                    }
                }
                printf("%s\n", str);
                return 0;
            }

    8. Sorting Characters in a String
       Problem : Sort the characters of "engineering" to get "eeeggiinnnr".
       Solution:
            #include <stdio.h>
            #include <string.h>
            int main() {
                char str[] = "engineering";
                int len = strlen(str);
                for (int i = 0; i < len - 1; i++) {
                    for (int j = i + 1; j < len; j++) {
                        if (str[i] > str[j]) {
                            char temp = str[i];
                            str[i] = str[j];
                            str[j] = temp;
                        }
                    }
                }
                printf("%s\n", str);
                return 0;
            }

    9. Searching for a Character
       Problem : Search for the character 'e' in "engineering" and print
                whether it is found or not.
       Solution:
            #include <stdio.h>
            int main() {
                char str[] = "engineering";
                char ch = 'e';
                int found = 0;
                for (int i = 0; str[i] != '\0'; i++) {
                    if (str[i] == ch) {
                        found = 1;
                        break;
                    }
                }
                if (found)
                    printf("'%c' found\n", ch);
                else
                    printf("'%c' not found\n", ch);
                return 0;
            }

    10. Character Replacement
        Problem : Replace all vowels in "How Are You" with '#'.
                 Output: "H#w #r# Y##"
        Solution:
            #include <stdio.h>
            #include <string.h>
            int main() {
                char str[] = "How Are You";
                char vowels[] = "aeiouAEIOU";
                for (int i = 0; str[i] != '\0'; i++) {
                    if (strchr(vowels, str[i]))
                        str[i] = '#';
                }
                printf("%s\n", str);
                return 0;
            }

    11. Case Conversion (Toggle Case)
        Problem : Convert "How Are You" to "hOW aRE yOU".
        Solution:
            #include <stdio.h>
            #include <ctype.h>
            int main() {
                char str[] = "How Are You";
                for (int i = 0; str[i] != '\0'; i++) {
                    if (islower(str[i]))
                        str[i] = toupper(str[i]);
                    else if (isupper(str[i]))
                        str[i] = tolower(str[i]);
                }
                printf("%s\n", str);
                return 0;
            }

    12. Deleting All Occurrences of a Character
        Problem : Delete all 'e' characters from "engineering".
                 Result: "nginring"? Actually careful: deleting all 'e' from "engineering"
                 gives "nginring". Let's compute: e n g i n e e r i n g -> remove e's -> n g i n r i n g -> "nginring".
                 Implement it in-place.
        Solution:
            #include <stdio.h>
            int main() {
                char str[] = "engineering";
                char ch = 'e';
                int j = 0;
                for (int i = 0; str[i] != '\0'; i++) {
                    if (str[i] != ch)
                        str[j++] = str[i];
                }
                str[j] = '\0';
                printf("%s\n", str);
                return 0;
            }

    13. Frequency Count of Each Character
        Problem : Count the frequency of each character in "hello world" (case‑sensitive).
        Solution:
            #include <stdio.h>
            int main() {
                char str[] = "hello world";
                int freq[256] = {0};
                for (int i = 0; str[i] != '\0'; i++) {
                    freq[(int)str[i]]++;
                }
                for (int i = 0; i < 256; i++) {
                    if (freq[i] > 0)
                        printf("'%c' : %d\n", i, freq[i]);
                }
                return 0;
            }

    14. Splitting CamelCase Words
        Problem : Convert "thisIsAnAutomationEra" into "this is an automation era".
        Solution:
            #include <stdio.h>
            #include <ctype.h>
            #include <string.h>
            int main() {
                char str[] = "thisIsAnAutomationEra";
                char result[200];
                int j = 0;
                for (int i = 0; str[i] != '\0'; i++) {
                    if (isupper(str[i]) && i != 0) {
                        result[j++] = ' ';
                        result[j++] = tolower(str[i]);
                    } else {
                        result[j++] = str[i];
                    }
                }
                result[j] = '\0';
                printf("%s\n", result);
                return 0;
            }

    15. Base Conversion – Hex to Decimal ("sweet seventeen")
        Problem : Convert the hexadecimal string "23GF" to its decimal equivalent.
                 (Note: 'G' is not a valid hex digit. We'll assume valid hex string, e.g., "23AF".)
                 Input: "23AF", Output: 9135
        Solution:
            #include <stdio.h>
            #include <string.h>
            int main() {
                char hex[] = "23AF";
                int decimal = 0;
                int len = strlen(hex);
                for (int i = 0; i < len; i++) {
                    int digit;
                    if (hex[i] >= '0' && hex[i] <= '9')
                        digit = hex[i] - '0';
                    else if (hex[i] >= 'A' && hex[i] <= 'F')
                        digit = hex[i] - 'A' + 10;
                    else if (hex[i] >= 'a' && hex[i] <= 'f')
                        digit = hex[i] - 'a' + 10;
                    else {
                        printf("Invalid hex digit\n");
                        return 1;
                    }
                    decimal = decimal * 16 + digit;
                }
                printf("Decimal = %d\n", decimal);
                return 0;
            }

    16. Dynamic String – Copying Without strcpy
        Problem : Read a string, dynamically allocate memory for a duplicate, copy it manually, and print.
        Solution:
            #include <stdio.h>
            #include <stdlib.h>
            int main() {
                char temp[100];
                scanf("%s", temp);
                int len = 0;
                while (temp[len]) len++;
                char *dup = (char*)malloc(len + 1);
                if (!dup) return 1;
                for (int i = 0; i <= len; i++) dup[i] = temp[i];
                printf("Duplicate: %s\n", dup);
                free(dup);
                return 0;
            }

    17. Scanset – Reading Only Digits
        Problem : Read input until a non‑digit is encountered and store only the digits.
        Solution:
            #include <stdio.h>
            int main() {
                char digits[100];
                scanf("%[0-9]", digits);   // reads only digits, stops at non-digit
                printf("Digits: %s\n", digits);
                return 0;
            }
